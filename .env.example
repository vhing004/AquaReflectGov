# ═══════════════════════════════════════════════════════════════════════════════
# AquaReflect - Biến Môi Trường Docker Compose
# Sao chép file này thành .env và điền giá trị thật trước khi chạy production.
# KHÔNG commit file .env vào Git (đã có trong .gitignore).
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL Database ────────────────────────────────────────────────────
POSTGRES_DB=aquareflect_db
POSTGRES_USER=postgres
# ⚠️ THAY ĐỔI MẬT KHẨU NÀY TRƯỚC KHI DEPLOY PRODUCTION!
POSTGRES_PASSWORD=AquaReflect@2026!
POSTGRES_PORT=5432

# ─── Backend ASP.NET Core ───────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ─── JWT Authentication ─────────────────────────────────────────────────────
# ⚠️ THAY ĐỔI SECRET KEY NÀY TRƯỚC KHI DEPLOY PRODUCTION (tối thiểu 64 ký tự)!
JWT_SECRET_KEY=AquaReflect_Secure_Super_Secret_Key_2026_Fisheries_Management_Key_Must_Be_Long
JWT_ISSUER=AquaReflectServer
JWT_AUDIENCE=AquaReflectClient
JWT_EXPIRY_MINUTES=1440

# ─── Cloudflare Turnstile (Chống Bot) ──────────────────────────────────────
# Đặt TURNSTILE_ENABLED=true và điền key thật khi deploy production
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

# ─── CORS / Frontend ────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost

# ─── HTTP Port ──────────────────────────────────────────────────────────────
HTTP_PORT=80
